msgid "Code file"
msgstr "فایل کد"

msgid "Kept by you"
msgstr "نگه‌داشته‌شده به دست شما"

msgid "Marked as used outside the site."
msgstr "برای استفاده‌ی بیرون از سایت علامت خورده است."

msgid "Remove the mark"
msgstr "برداشتن علامت"

#, php-format
msgid "Attachment #%d"
msgstr "پیوست #%d"

msgid "It has the same file and is in use; deleting this attachment deletes the shared file and breaks the other one's image too."
msgstr "همین فایل را دارد و استفاده شده است؛ حذف این پیوست فایل مشترک را پاک می‌کند و تصویر آن یکی هم می‌شکند."

