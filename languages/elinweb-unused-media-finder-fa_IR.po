msgstr "جدول افزونه"

msgid "Content"
msgstr "محتوا"

msgid "Featured image"
msgstr "تصویر شاخص"

msgid "Product gallery"
msgstr "گالری محصول"

msgid "Elementor"
msgstr "المنتور"

msgid "Description"
msgstr "توضیحات"

msgid "By ID"
msgstr "با شناسه"

msgid "By URL"
msgstr "با آدرس"

msgid "Quarantined"
msgstr "در قرنطینه"

msgid "Not scanned"
msgstr "اسکن نشده"

#, php-format
msgid "Used in %s place(s)"
msgstr "%s محل استفاده"

msgid "Usage"
msgstr "استفاده"

#, php-format
msgid "This scan cannot be trusted: %1$s featured image(s) (such as %2$s) that are certainly in use came back unreferenced. Quarantine and delete are disabled. Run the scan again; if it repeats, report it."
msgstr "این اسکن قابل اعتماد نیست: %1$s تصویر شاخص (مثل %2$s) که حتماً استفاده می‌شوند، بدون ارجاع آمدند. پس قرنطینه و حذف غیرفعال است. اسکن را دوباره اجرا کنید؛ اگر باز تکرار شد، گزارش دهید."

msgid "Database + source code"
msgstr "دیتابیس + سورس کد"

msgid "Database only"
msgstr "فقط دیتابیس"

msgid ", with plugin tables"
msgstr "، با جدول‌های افزونه‌ها"

msgid "Duplicates"
msgstr "تکراری‌ها"

msgid "Extra files"
msgstr "فایل‌های اضافه"

msgid "Unregistered sizes"
msgstr "سایزهای ثبت‌نشده"

msgid "Unused Media Finder sections"
msgstr "بخش‌های یابنده‌ی رسانه‌های بی‌استفاده"

msgid "This section needs the result of a full scan."
msgstr "این بخش به نتیجه‌ی یک اسکن کامل نیاز دارد."

msgid "Run a scan"
msgstr "اجرای اسکن"

#, php-format
msgid "%s media moved to quarantine."
msgstr "%s رسانه به قرنطینه رفت."

#, php-format
msgid "%s media restored to their original place."
msgstr "%s رسانه به جای اصلی برگشت."

#, php-format
msgid "%s media deleted permanently."
msgstr "%s رسانه برای همیشه حذف شد."

#, php-format
