msgstr "ارجاع‌ها در %s محل بازنویسی شدند."

msgid "The replaced copy was quarantined."
msgstr "نسخه‌ی جایگزین‌شده به قرنطینه رفت."

msgid "The replaced copy was deleted permanently."
msgstr "نسخه‌ی جایگزین‌شده برای همیشه حذف شد."

msgid "The replaced copy could not be moved to quarantine; it is now unreferenced and listed under Unreferenced."
msgstr "نسخه‌ی جایگزین‌شده به قرنطینه نرفت؛ حالا بدون ارجاع است و در تب «بدون ارجاع» دیده می‌شود."

msgid "The extra file stays on disk; after the next scan finds no reference to it, it can be deleted."
msgstr "فایل اضافه روی دیسک می‌ماند؛ وقتی اسکن بعدی ارجاعی به آن پیدا نکند، می‌شود حذفش کرد."

msgid "The merge was undone."
msgstr "ادغام برگردانده شد."

msgid "Interrupted; continue or undo it."
msgstr "نیمه‌کاره ماند؛ ادامه‌اش دهید یا برش گردانید."

msgid "Keep this copy"
msgstr "این نسخه بماند"

#, php-format
msgid "Keep %s"
msgstr "نگه‌داشتن %s"

msgid "Files with exactly identical content that were uploaded more than once. Sizes are compared first, and only same-size files are checked by content hash (MD5). Attachments that share one file from the start (such as media translations) are not counted as duplicates. Only unreferenced copies can be selected. When copies are in use, choose the copy to keep and replace the others with it: a preview shows every place that will be rewritten, and every merge can be undone."
msgstr "فایل‌هایی با محتوای کاملاً یکسان که بیش از یک بار آپلود شده‌اند. اول حجم‌ها مقایسه می‌شوند و فقط فایل‌های هم‌حجم با هش محتوا (MD5) بررسی می‌شوند. پیوست‌هایی که از اول یک فایل مشترک دارند (مثل ترجمه‌های رسانه) تکراری حساب نمی‌شوند. فقط نسخه‌های بدون ارجاع قابل انتخاب‌اند. وقتی نسخه‌ها استفاده شده‌اند، نسخه‌ای را که می‌ماند انتخاب کنید و بقیه را با آن جایگزین کنید: پیش‌نمایش همه‌ی محل‌هایی را که بازنویسی می‌شوند نشان می‌دهد و هر ادغام برگرداندنی است."

msgid "Replace the other copies with the selected one…"
msgstr "جایگزینی نسخه‌های دیگر با نسخه‌ی انتخاب‌شده…"

msgid "Where?"
msgstr "کجا؟"

