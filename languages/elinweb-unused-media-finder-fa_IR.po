msgstr "انجام شد"

msgid "Undone"
msgstr "برگردانده شد"

msgid "Rolled back"
msgstr "لغو و برگردانده شد"

msgid "Failed"
msgstr "ناموفق"

msgid "Interrupted"
msgstr "نیمه‌کاره"

msgid "Recent merges"
msgstr "ادغام‌های اخیر"

msgid "Date"
msgstr "تاریخ"

msgid "Kept copy"
msgstr "نسخه‌ی ماندنی"

msgid "Replaced copy"
msgstr "نسخه‌ی جایگزین‌شده"

msgid "Values changed"
msgstr "مقدارهای تغییرکرده"

msgid "Result"
msgstr "نتیجه"

msgid "Undo this merge"
msgstr "برگرداندن این ادغام"

msgid "Cannot be undone: the copy was deleted permanently."
msgstr "برگرداندنی نیست: نسخه برای همیشه حذف شده است."

msgid "Only the last 50 merges are logged and can be undone. Undo brings the copy back from quarantine and restores every value that has not been changed since."
msgstr "فقط ۵۰ ادغام آخر ثبت می‌شوند و برگرداندنی‌اند. برگرداندن، نسخه را از قرنطینه برمی‌گرداند و هر مقداری را که از آن به بعد تغییر نکرده به حالت قبل برمی‌گرداند."

msgid "Kept copy:"
msgstr "نسخه‌ی ماندنی:"

